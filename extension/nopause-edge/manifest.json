{
  "manifest_version": 3,
  "name": "不暂停 · 学习通专用",
  "version": "2.0.0",
  "description": "学习通（chaoxing.com）专用：干掉「鼠标移开 / 窗口失焦就暂停视频」，万一还是被暂停会立刻续播。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["*://*.chaoxing.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "不暂停（Alt+Shift+X 快速开关本站）",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": ["src/guard.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ],
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "学习通（chaoxing.com）专用：干掉「鼠标移开 / 窗口失焦就暂停视频」，万一还是被暂停会立刻续播。"
    }
  }
}
