#include <windows.h>

#pragma code_page(65001)

#include "resource.h"

IDI_APP ICON "res/app.ico"

1 24 "src/app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "ruorain"
            VALUE "FileDescription", "TopVideoMonitor - 置顶视频播放监控条"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "TopVideoMonitor"
            VALUE "OriginalFilename", "TopVideoMonitor.exe"
            VALUE "ProductName", "TopVideoMonitor"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 336, 306
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "视频播放监控 · 设置"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "① 受控浏览器（必须用它播视频）", IDC_STATIC, 7, 6, 322, 46
    LTEXT           "正在检查…", IDC_CONN, 15, 19, 306, 10
    PUSHBUTTON      "启动受控浏览器", IDC_LAUNCH, 15, 32, 72, 15
    PUSHBUTTON      "重新扫描", IDC_RESCAN, 91, 32, 52, 15

    GROUPBOX        "② 选择两个窗口（选中一行，再设为视频1/2）", IDC_STATIC, 7, 56, 322, 128
    LISTBOX         IDC_LIST, 14, 68, 308, 80, LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "自动指定", IDC_AUTO, 14, 152, 52, 15
    PUSHBUTTON      "设为视频1", IDC_BIND1, 70, 152, 58, 15
    PUSHBUTTON      "设为视频2", IDC_BIND2, 132, 152, 58, 15
    PUSHBUTTON      "取消绑定", IDC_UNBIND, 194, 152, 52, 15
    LTEXT           "", IDC_BINDINFO, 14, 170, 308, 10

    GROUPBOX        "③ 提醒方式", IDC_STATIC, 7, 188, 322, 84
    LTEXT           "停止判断", IDC_STATIC, 15, 202, 40, 9
    EDITTEXT        IDC_THRESH, 56, 200, 26, 13, ES_NUMBER
    LTEXT           "秒", IDC_STATIC, 85, 202, 10, 9
    LTEXT           "闪烁间隔", IDC_STATIC, 104, 202, 40, 9
    EDITTEXT        IDC_FLASH, 146, 200, 32, 13, ES_NUMBER
    LTEXT           "毫秒", IDC_STATIC, 181, 202, 24, 9
    LTEXT           "提示音间隔", IDC_STATIC, 212, 202, 44, 9
    EDITTEXT        IDC_BEEP, 258, 200, 26, 13, ES_NUMBER
    LTEXT           "秒", IDC_STATIC, 287, 202, 10, 9
    CONTROL         "声音提醒", IDC_SOUND, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 218, 58, 10
    LTEXT           "字号", IDC_STATIC, 82, 219, 22, 9
    EDITTEXT        IDC_FONT, 106, 217, 26, 13, ES_NUMBER
    LTEXT           "不透明度", IDC_STATIC, 144, 219, 36, 9
    CONTROL         "", IDC_ALPHA, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 184, 217, 88, 14
    PUSHBUTTON      "试听", IDC_PREVIEW, 280, 216, 40, 15
    LTEXT           "", IDC_STATE, 15, 238, 306, 10

    DEFPUSHBUTTON   "保存并关闭", IDOK, 224, 284, 58, 16
    PUSHBUTTON      "取消", IDCANCEL, 286, 284, 42, 16
END
